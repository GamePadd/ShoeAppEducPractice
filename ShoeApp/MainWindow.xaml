<Window x:Class="ShoeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeApp"
        mc:Ignorable="d"
        Title="Фруктим" Height="620" Width="1200"
        Icon="/Images/FruktimLogo.ico"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" 
                    Grid.Row="0" 
                    Background="{StaticResource AccentBackground}">
            <Image Source="Images/logo-ver3.png"
                   Height="50"
                   HorizontalAlignment="Left"
                   Margin="15"/>

        </StackPanel>

        <TextBlock FontSize="25"
                   FontWeight="Bold"
                   Grid.Row="0"
                   Foreground="White"
                   Margin="0 0 15 0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   x:Name="fullName"/>

        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
