<Page x:Class="ShoeApp.Pages.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid>
        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="320">
            <Image Source="/Images/Чудо Обувь.png"
                   Height="100"
                   Margin="0, 0, 0, 0"/>
            <TextBlock Text="Вход в систему"
                       HorizontalAlignment="Center"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0, 0, 0, 10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Логин:" VerticalAlignment="Center" Margin="5 0 5 0"/>
                <TextBox x:Name="loginField" Width="265"/>
            </StackPanel>

            <Button Content="Войти"
                    Click="Login_Click"/>
            <Button Content="Войти как гость"
                    Click="Guest_Click"
                    Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>
